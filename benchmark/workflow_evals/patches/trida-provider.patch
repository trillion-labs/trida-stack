diff --git a/core/trida_client.py b/core/trida_client.py
new file mode 100644
index 0000000..4959168
--- /dev/null
+++ b/core/trida_client.py
@@ -0,0 +1,80 @@
+"""Transport adapter only; workflow questions, policies and scoring stay upstream."""
+import math
+import os
+
+import httpx
+from pydantic import Field
+
+from .question_types import SystemOneResponse, question_record
+
+
+class TridaResponse(SystemOneResponse):
+    decision_details: dict = Field(default_factory=dict)
+
+
+class TridaClient:
+    def __init__(self, config):
+        self.model = config.model
+        self.reasoning = config.trida_reasoning
+        self.max_reasoning_tokens = config.max_output_tokens
+        headers = {}
+        if key := os.getenv("TRIDA_API_KEY"):
+            headers["Authorization"] = f"Bearer {key}"
+        self.client = httpx.Client(
+            base_url=config.base_url.rstrip("/") + "/",
+            timeout=config.timeout_s,
+            headers=headers,
+        )
+
+    def system_one(self, *, model, state, questions) -> SystemOneResponse:
+        wire = {key: question_record(q) for key, q in questions.items()}
+        body = {"request": {"state": state, "questions": wire}, "reasoning": self.reasoning}
+        if self.reasoning:
+            body["max_reasoning_tokens"] = self.max_reasoning_tokens
+        response = self.client.post("v1/decide", json=body)
+        try:
+            response.raise_for_status()
+        except httpx.HTTPStatusError as exc:
+            raise httpx.HTTPStatusError(
+                f"{exc}: {response.text[:2000]}", request=exc.request, response=exc.response
+            ) from exc
+        raw = response.json()
+        if self.reasoning and (not raw.get("reasoning") or raw.get("cut")):
+            raise ValueError(f"Reasoning did not complete: {raw.get('cut') or 'missing reasoning'}")
+        answers = raw["answers"]
+        if set(answers) != set(wire):
+            raise ValueError("Response question IDs differ from the requested question IDs")
+        for key, question in wire.items():
+            answer = answers[key]
+            if answer["type"] != question["type"]:
+                raise ValueError(f"Answer type differs for {key}")
+            if question["type"] == "noul":
+                self._probabilities([answer["noul"]], distribution=False)
+                continue
+            criteria = question["criteria"]
+            keys = set(criteria) if question["type"] == "choice" else {str(i) for i in range(len(criteria))}
+            if set(answer["probabilities"]) != keys:
+                raise ValueError(f"Probability keys differ for {key}")
+            self._probabilities(list(answer["probabilities"].values()), distribution=True)
+            if question["type"] == "choice" and answer["choice"] not in keys:
+                raise ValueError(f"Unknown choice for {key}")
+            if question["type"] == "score":
+                # Trida supplies a list; the TypeSafe SDK expects an index-to-level mapping.
+                answer["legend"] = dict(enumerate(criteria))
+                answer["probabilities"] = {int(k): p for k, p in answer["probabilities"].items()}
+        return TridaResponse.model_validate(
+            {"model": self.model, "answers": answers, "usage": raw.get("usage") or {},
+             "decision_details": {k: v for k, v in raw.items() if k not in ("answers", "usage")}}
+        )
+
+    @staticmethod
+    def _probabilities(values, *, distribution):
+        if any(isinstance(p, bool) or not isinstance(p, (int, float))
+               or not math.isfinite(p) or not 0 <= p <= 1 for p in values):
+            raise ValueError("Invalid probability")
+        # The server rounds probabilities to four decimal places. Preserve them unchanged.
+        if distribution and abs(sum(values) - 1) > len(values) * 0.00005 + 1e-8:
+            raise ValueError("Probabilities do not sum to one")
+
+    def close(self):
+        self.client.close()
