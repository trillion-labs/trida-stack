+    def _capture_trida_decision_prefill(self, batch, result):
+        output = result.logits_output
+        states = output.hidden_states
+        for i, req in enumerate(batch.reqs):
+            if not req.return_hidden_states or req.hidden_states:
+                continue
+            error = getattr(output, "trida_decision_readout_error", None)
+            if error is None and not getattr(output, "trida_decision_prefill", False):
+                continue
+            if error is None:
+                end_ids = getattr(output, "trida_decision_end_ids", None)
+                lengths = getattr(output, "trida_decision_seq_lens", None)
+                if states is None or states.shape[0] != len(batch.reqs):
+                    error = "decision readout hidden-state batch mismatch"
+                elif end_ids is None or lengths is None or len(end_ids) != len(batch.reqs) or len(lengths) != len(batch.reqs):
+                    error = "decision readout missing prompt endpoints"
+                elif not req.origin_input_ids or end_ids[i] != req.origin_input_ids[-1] or lengths[i] != len(req.origin_input_ids):
+                    error = "decision readout captured the wrong prompt endpoint"
+            if error is not None:
+                logger.warning("%s; aborting decision request %s", error, req.rid)
+                req.set_finish_with_abort(error)
+                continue
+            exported = states[i:i + 1].float().cpu()
+            if os.environ.get("TRIDA_DECISION_READOUT_AUDIT") == "1":
+                import torch
+                if not torch.equal(torch.tensor(exported.tolist(), dtype=torch.float32), exported):
+                    req.set_finish_with_abort("decision readout export changed hidden states")
+                    continue
+                print("trida_decision_readout_verified", lengths[i], end_ids[i], flush=True)
+            req.hidden_states.append(exported.tolist())
+
